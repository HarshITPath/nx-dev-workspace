    "lint:admin": "nx run frontend-admin:lint",
    "lint:customer": "nx run frontend-customer:lint",
    "lint:backend": "nx run backend:lint",
    "start:all:dev": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:customer\"",
    "start:all:staging": "concurrently \"npm run dev:backend:staging\" \"npm run dev:admin:staging\" \"npm run dev:customer:staging\"",
    "env:check": "node scripts/check-env.js"
