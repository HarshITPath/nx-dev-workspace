  "scripts": {
    "dev:admin": "nx run frontend-admin:dev",
    "dev:admin:staging": "nx run frontend-admin:dev:staging",
    "dev:admin:production": "nx run frontend-admin:dev:production",
    "dev:customer": "nx run frontend-customer:dev",
