# Development Environment
[development]
PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:4200,http://localhost:4300

# Staging Environment  
[staging]
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://staging-admin.example.com,https://staging-customer.example.com

# Production Environment
[production]
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=https://admin.example.com,https://customer.example.com# apps/backend/.env
