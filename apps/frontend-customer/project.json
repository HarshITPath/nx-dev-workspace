{
  "name": "frontend-customer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend-customer/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend-customer"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "staging": {
          "mode": "staging"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npx nx run frontend-customer:dev:development"
      },
      "configurations": {
        "development": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env development -- npx nx run frontend-customer:dev:development"
        },
        "staging": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env staging -- npx nx run frontend-customer:dev:staging"
        },
        "production": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env production -- npx nx run frontend-customer:dev:production"
        }
      }
    },
    "dev:development": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-customer:build:development",
        "port": 4300
      }
    },
    "dev:staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env staging -- npx nx run frontend-customer:dev:staging-server"
      }
    },
    "dev:staging-server": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-customer:build:staging",
        "port": 4300,
        "hmr": false,
        "mode": "staging"
      }
    },
    "dev:production": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-customer:build:production",
        "port": 4300,
        "hmr": false
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npx nx run frontend-customer:preview:development"
      },
      "configurations": {
        "development": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env development -- npx nx run frontend-customer:preview:development"
        },
        "production": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-customer/.env --env production -- npx nx run frontend-customer:preview:production"
        }
      }
    },
    "preview:development": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "frontend-customer:build:development"
      }
    },
    "preview:production": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "frontend-customer:build:production"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/apps/frontend-customer"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/frontend-customer"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/frontend-customer/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}