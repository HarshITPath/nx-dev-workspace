{
  "name": "frontend-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend-admin/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend-admin"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "staging": {
          "mode": "production"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npx nx run frontend-admin:dev:development"
      },
      "configurations": {
        "development": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-admin/.env --env development -- npx nx run frontend-admin:dev:development"
        },
        "staging": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-admin/.env --env staging -- npx nx run frontend-admin:dev:staging"
        },
        "production": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-admin/.env --env production -- npx nx run frontend-admin:dev:production"
        }
      }
    },
    "dev:development": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-admin:build:development",
        "port": 4200
      }
    },
    "dev:staging": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-admin:build:staging",
        "port": 4200,
        "hmr": false
      }
    },
    "dev:production": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "frontend-admin:build:production",
        "port": 4200,
        "hmr": false
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npx nx run frontend-admin:preview:development"
      },
      "configurations": {
        "development": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-admin/.env --env development -- npx nx run frontend-admin:preview:development"
        },
        "production": {
          "command": "node scripts/run-with-env.cjs --file apps/frontend-admin/.env --env production -- npx nx run frontend-admin:preview:production"
        }
      }
    },
    "preview:development": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "frontend-admin:build:development"
      }
    },
    "preview:production": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "frontend-admin:build:production"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/apps/frontend-admin"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/frontend-admin"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/frontend-admin/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}